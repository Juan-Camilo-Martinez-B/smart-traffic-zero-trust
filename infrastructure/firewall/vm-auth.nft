#!/usr/sbin/nft -f

flush ruleset

# =======================================================
# ZERO TRUST FIREWALL CONFIGURATION - AUTH ZONE
# =======================================================
# Replace these with the actual private IPs of your EC2 instances:
define IP_INGEST = 10.0.1.142
define IP_CORE   = 10.0.1.111
define IP_APP    = 10.0.1.146

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        # Loopback
        iif "lo" accept

        # Keep existing active connections
        ct state established,related accept

        # Allow SSH (Port 22)
        tcp dport 22 accept

        # Allow HTTPS / Auth Service (Port 443) ONLY from specific zones
        ip saddr { $IP_INGEST, $IP_CORE, $IP_APP } tcp dport 443 accept
    }

    chain forward {
        type filter hook forward priority 0; policy accept;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
