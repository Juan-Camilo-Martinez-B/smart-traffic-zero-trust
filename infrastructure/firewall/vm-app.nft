#!/usr/sbin/nft -f

flush ruleset

# =======================================================
# ZERO TRUST FIREWALL CONFIGURATION - APP ZONE
# =======================================================
table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        # Loopback
        iif "lo" accept

        # Keep existing active connections
        ct state established,related accept

        # Allow SSH (Port 22)
        tcp dport 22 accept

        # Allow Dashboard / WebSocket Server (Port 3000) from anywhere
        tcp dport 3000 accept
    }

    chain forward {
        type filter hook forward priority 0; policy accept;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
